<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MaxCall — MaxCare</title>
  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- الخطوط: IBM Plex Sans Arabic + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script>
    // إعداد ألوان هوية MaxCare داخل Tailwind
    tailwind.config = {
      theme: {
        extend: {
          colors: { maxteal: '#087B78', maxgold: '#D6A62A' },
          fontFamily: { sans: ['"IBM Plex Sans Arabic"', 'Inter', 'sans-serif'] }
        }
      }
    };
  </script>
</head>
<body class="bg-slate-100 font-sans text-slate-800 antialiased">
  <!-- هيكل التطبيق: عمود موبايل مركزي -->
  <div class="mx-auto flex min-h-screen w-full max-w-md flex-col bg-white shadow-xl">

    <!-- هيدر الهوية -->
    <header class="bg-maxteal px-5 pb-4 pt-5 text-white">
      <div class="flex items-center justify-between">
        <!-- الشعار -->
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-maxgold text-lg font-bold text-maxteal">M</div>
          <div>
            <p class="text-lg font-bold leading-tight">MaxCare</p>
            <p class="text-xs text-white/80">MaxCall • مقسم VitalPBX</p>
          </div>
        </div>
        <!-- حالة التسجيل -->
        <div class="flex items-center gap-2 rounded-full bg-white/15 px-3 py-1.5 text-xs font-medium">
          <span id="regDot" class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
          <span id="regText">مسجّل</span>
        </div>
      </div>
      <!-- شريط ذهبي + الحضور -->
      <div class="mt-4 flex items-center justify-between gap-3">
        <div class="h-1 flex-1 overflow-hidden rounded-full bg-white/20">
          <div class="h-full w-2/3 rounded-full bg-maxgold"></div>
        </div>
        <select id="presenceSelect" class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-maxteal outline-none">
          <option value="available">متاح</option>
          <option value="busy">مشغول</option>
          <option value="away">غير موجود</option>
          <option value="offline">غير متصل</option>
        </select>
      </div>
    </header>

    <!-- بانر مكالمة واردة -->
    <div id="incomingBanner" class="hidden border-b border-slate-100 bg-amber-50 px-5 py-3">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-maxteal text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>
          </div>
          <div>
            <p class="text-sm font-bold">مكالمة واردة</p>
            <p id="incomingNumber" class="text-xs text-slate-500" dir="ltr">05xxxxxxxx</p>
          </div>
        </div>
        <div class="flex gap-2">
          <button id="btnAnswer" class="rounded-full bg-emerald-500 px-4 py-2 text-xs font-bold text-white active:scale-95">رد</button>
          <button id="btnReject" class="rounded-full bg-rose-500 px-4 py-2 text-xs font-bold text-white active:scale-95">رفض</button>
        </div>
      </div>
    </div>

    <!-- المحتوى -->
    <main class="flex-1 px-5 pb-28 pt-4">

      <!-- تبويب: اتصال -->
      <section id="tab-call" class="space-y-4">
        <!-- شاشة الرقم -->
        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4">
          <p class="text-xs text-slate-400">الرقم المطلوب</p>
          <div class="mt-1 flex items-center gap-2">
            <input id="dialInput" dir="ltr" inputmode="tel" placeholder="05x xxx xxxx"
              class="w-full bg-transparent text-center text-2xl font-bold tracking-widest text-slate-800 outline-none placeholder:text-slate-300" />
            <button id="btnBackspace" aria-label="مسح" class="rounded-full p-2 text-slate-400 hover:bg-slate-200">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M21 5H8l-5 7 5 7h13a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1Z"/><path d="m12 9 6 6M18 9l-6 6"/></svg>
            </button>
          </div>
          <p id="callState" class="mt-1 text-center text-xs font-medium text-slate-400">جاهز للاتصال</p>
        </div>

        <!-- لوحة الأرقام -->
        <div class="grid grid-cols-3 gap-2.5" id="dialPad">
          <button data-digit="1" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">1</button>
          <button data-digit="2" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">2</button>
          <button data-digit="3" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">3</button>
          <button data-digit="4" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">4</button>
          <button data-digit="5" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">5</button>
          <button data-digit="6" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">6</button>
          <button data-digit="7" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">7</button>
          <button data-digit="8" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">8</button>
          <button data-digit="9" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">9</button>
          <button data-digit="*" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold text-slate-400 hover:bg-teal-50 hover:text-maxteal active:scale-95">*</button>
          <button data-digit="0" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold hover:bg-teal-50 hover:text-maxteal active:scale-95">0</button>
          <button data-digit="#" class="rounded-2xl bg-slate-50 py-3.5 text-xl font-bold text-slate-400 hover:bg-teal-50 hover:text-maxteal active:scale-95">#</button>
        </div>

        <!-- زر الاتصال الكبير + تحكم -->
        <div class="flex items-center justify-center gap-3 pt-1">
          <button id="btnHold" title="تعليق" class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
          </button>
          <button id="btnCall" class="flex h-16 w-16 items-center justify-center rounded-full bg-maxteal text-white shadow-lg shadow-teal-900/30 transition active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-7 w-7"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>
          </button>
          <button id="btnHangup" title="إنهاء" class="flex h-12 w-12 rotate-[135deg] items-center justify-center rounded-full bg-rose-500 text-white hover:bg-rose-600 active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>
          </button>
        </div>
      </section>

      <!-- تبويب: جهات -->
      <section id="tab-contacts" class="hidden space-y-3">
        <!-- بحث -->
        <div class="flex items-center gap-2 rounded-2xl bg-slate-50 px-4 py-3">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 text-slate-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input placeholder="بحث في الجهات…" class="w-full bg-transparent text-sm outline-none placeholder:text-slate-400" />
        </div>
        <!-- عناصر تجريبية -->
        <div class="divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-100">
          <div class="flex items-center justify-between bg-white p-3.5">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-teal-50 font-bold text-maxteal">س</div>
              <div><p class="text-sm font-bold">سارة العتيبي</p><p class="text-xs text-slate-400" dir="ltr">0551 234 567</p></div>
            </div>
            <button data-call="0551234567" class="rounded-full bg-maxteal/10 px-3 py-1.5 text-xs font-bold text-maxteal">اتصال</button>
          </div>
          <div class="flex items-center justify-between bg-white p-3.5">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-50 font-bold text-amber-600">م</div>
              <div><p class="text-sm font-bold">محمد القحطاني</p><p class="text-xs text-slate-400" dir="ltr">0567 890 123</p></div>
            </div>
            <button data-call="0567890123" class="rounded-full bg-maxteal/10 px-3 py-1.5 text-xs font-bold text-maxteal">اتصال</button>
          </div>
          <div class="flex items-center justify-between bg-white p-3.5">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 font-bold text-slate-500">د</div>
              <div><p class="text-sm font-bold">دعم MaxCare</p><p class="text-xs text-slate-400" dir="ltr">920 001 100</p></div>
            </div>
            <button data-call="920001100" class="rounded-full bg-maxteal/10 px-3 py-1.5 text-xs font-bold text-maxteal">اتصال</button>
          </div>
        </div>
      </section>

      <!-- تبويب: سجل -->
      <section id="tab-history" class="hidden space-y-2.5">
        <!-- مكالمات تجريبية -->
        <div class="flex items-center justify-between rounded-2xl border border-slate-100 bg-white p-3.5">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">↙</span>
            <div><p class="text-sm font-bold" dir="ltr">0551 234 567</p><p class="text-xs text-slate-400">اليوم • 09:41 • دقيقتان</p></div>
          </div>
          <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-bold text-emerald-600">واردة</span>
        </div>
        <div class="flex items-center justify-between rounded-2xl border border-slate-100 bg-white p-3.5">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-sky-50 text-sky-600">↗</span>
            <div><p class="text-sm font-bold" dir="ltr">0567 890 123</p><p class="text-xs text-slate-400">أمس • 15:20 • 45 ثانية</p></div>
          </div>
          <span class="rounded-full bg-sky-50 px-2.5 py-1 text-[11px] font-bold text-sky-600">صادرة</span>
        </div>
        <div class="flex items-center justify-between rounded-2xl border border-slate-100 bg-white p-3.5">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-rose-50 text-rose-500">↘</span>
            <div><p class="text-sm font-bold" dir="ltr">011 456 7890</p><p class="text-xs text-slate-400">أمس • 11:05 • فائتة</p></div>
          </div>
          <span class="rounded-full bg-rose-50 px-2.5 py-1 text-[11px] font-bold text-rose-500">فائتة</span>
        </div>
      </section>
    </main>

    <!-- شريط التبويبات السفلي -->
    <nav class="fixed bottom-0 left-1/2 w-full max-w-md -translate-x-1/2 border-t border-slate-100 bg-white/95 px-6 py-2 backdrop-blur">
      <div class="grid grid-cols-3 gap-1 text-center">
        <button data-tab="tab-call" class="tab-btn rounded-xl py-2 text-xs font-bold text-maxteal">
          <span class="mx-auto mb-1 block h-1 w-8 rounded-full bg-maxgold"></span>اتصال
        </button>
        <button data-tab="tab-contacts" class="tab-btn rounded-xl py-2 text-xs font-medium text-slate-400">
          <span class="mx-auto mb-1 block h-1 w-8 rounded-full bg-transparent"></span>جهات
        </button>
        <button data-tab="tab-history" class="tab-btn rounded-xl py-2 text-xs font-medium text-slate-400">
          <span class="mx-auto mb-1 block h-1 w-8 rounded-full bg-transparent"></span>سجل
        </button>
      </div>
    </nav>
  </div>

  <!-- الجسر ثم منطق الواجهة -->
  <script>
/* MaxCallBridge — طبقة الجسر بين الواجهة و C++ عبر WebView2 */
'use strict';

/**
 * يرسل رسالة إلى C++ بأمان (WebView2 أو fallback للتصفح العادي).
 * @param {object} msg رسالة بصيغة {action, ...}
 * @returns {boolean} true إذا أُرسلت عبر WebView2
 */
function _postToNative(msg) {
  try {
    if (window.chrome && window.chrome.webview && typeof window.chrome.webview.postMessage === 'function') {
      window.chrome.webview.postMessage(msg);
      return true;
    }
  } catch (e) {
    console.warn('[MaxCallBridge] postMessage failed:', e);
  }
  console.log('[MaxCallBridge:fallback]', JSON.stringify(msg));
  return false;
}

/**
 * يبث حدث DOM داخلي لتحديث الواجهة.
 * @param {string} name اسم الحدث
 * @param {object} detail بيانات الحدث
 */
function _emit(name, detail) {
  window.dispatchEvent(new CustomEvent('maxcall:' + name, { detail }));
  console.log('[MaxCallBridge:rx]', name, detail || {});
}

/**
 * جسر MaxCall: إرسال JS->C++ واستقبال C++->JS.
 */
const MaxCallBridge = {
  // ---------- إرسال: JS -> C++ ----------

  /**
   * بدء مكالمة صادرة.
   * @param {{number: string}} p
   */
  makeCall(p) { _postToNative({ action: 'makeCall', number: String((p && p.number) || '') }); },

  /**
   * إنهاء المكالمة الحالية.
   * @param {{callId?: number}} p
   */
  hangup(p) { _postToNative({ action: 'hangup', callId: (p && p.callId) ?? -1 }); },

  /**
   * الرد على مكالمة واردة.
   * @param {{callId?: number}} p
   */
  answer(p) { _postToNative({ action: 'answer', callId: (p && p.callId) ?? -1 }); },

  /**
   * تعليق / استئناف المكالمة.
   * @param {{callId?: number, on: boolean}} p
   */
  hold(p) { _postToNative({ action: 'hold', callId: (p && p.callId) ?? -1, on: !!(p && p.on) }); },

  /**
   * تحويل المكالمة لرقم آخر.
   * @param {{callId?: number, target: string}} p
   */
  transfer(p) { _postToNative({ action: 'transfer', callId: (p && p.callId) ?? -1, target: String((p && p.target) || '') }); },

  /**
   * إرسال نغمة DTMF.
   * @param {{callId?: number, digit: string}} p رقم واحد 0-9/*#
   */
  sendDTMF(p) { _postToNative({ action: 'sendDTMF', callId: (p && p.callId) ?? -1, digit: String((p && p.digit) || '') }); },

  /**
   * تغيير حالة الحضور.
   * @param {{status: 'available'|'busy'|'away'|'offline'}} p
   */
  setPresence(p) { _postToNative({ action: 'setPresence', status: String((p && p.status) || 'available') }); },

  /**
   * إشعار C++ بأن الواجهة جاهزة لاستقبال اللقطة الأولية.
   * يرسل تلقائياً عند تحميل الصفحة.
   */
  ready() { _postToNative({ action: 'shellReady' }); },

  // ---------- استقبال: C++ -> JS ----------

  /**
   * مكالمة واردة جديدة (يستدعيها C++ عبر ExecuteScript).
   * @param {string} number رقم المتصل
   * @param {string} name اسم المتصل
   * @param {number} callId معرف المكالمة
   */
  onIncomingCall(number, name, callId) {
    const banner = document.getElementById('incomingBanner');
    const numEl = document.getElementById('incomingNumber');
    if (banner) banner.classList.remove('hidden');
    if (numEl) numEl.textContent = (name ? name + ' • ' : '') + number;
    _emit('incoming-call', { number, name, callId });
  },

  /**
   * تغيّر حالة المكالمة.
   * @param {number} callId معرف المكالمة
   * @param {string} state إحدى: idle|calling|ringing|active|held|ended
   */
  onCallState(callId, state) {
    const label = document.getElementById('callState');
    const map = { idle: 'جاهز للاتصال', calling: 'جارٍ الاتصال…', ringing: 'يرن…', active: 'مكالمة نشطة', held: 'المكالمة معلّقة', ended: 'انتهت المكالمة' };
    if (label) label.textContent = map[state] || state;
    if (state === 'ended') document.getElementById('incomingBanner')?.classList.add('hidden');
    _emit('call-state', { callId, state });
  },

  /**
   * تغيّر حالة التسجيل في المقسم.
   * @param {boolean} registered هل الحساب مسجّل؟
   * @param {string} message رسالة وصفية
   */
  onRegState(registered, message) {
    const dot = document.getElementById('regDot');
    const txt = document.getElementById('regText');
    if (dot) dot.className = 'h-2.5 w-2.5 rounded-full ' + (registered ? 'bg-emerald-400' : 'bg-rose-400');
    if (txt) txt.textContent = registered ? 'مسجّل' : 'غير مسجّل';
    _emit('reg-state', { registered, message });
  },

  /**
   * رسالة نصية / تنبيه من C++.
   * @param {string} from المرسل
   * @param {string} text نص الرسالة
   */
  onMessage(from, text) { _emit('message', { from, text }); },
};

// دوال عالمية يستدعيها C++ مباشرة عبر ExecuteScript (نفس أسلوب updateCallerInfo)
window.onIncomingCall = (...a) => MaxCallBridge.onIncomingCall(...a);
window.onCallState = (...a) => MaxCallBridge.onCallState(...a);
window.onRegState = (...a) => MaxCallBridge.onRegState(...a);
window.onMessage = (...a) => MaxCallBridge.onMessage(...a);
window.MaxCallBridge = MaxCallBridge;

</script>
  <script>
    // تبديل التبويبات
    const tabs = document.querySelectorAll('.tab-btn');
    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        ['tab-call', 'tab-contacts', 'tab-history'].forEach((id) => document.getElementById(id).classList.add('hidden'));
        document.getElementById(btn.dataset.tab).classList.remove('hidden');
        tabs.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('text-maxteal', active);
          b.classList.toggle('font-bold', active);
          b.classList.toggle('text-slate-400', !active);
          b.querySelector('span').classList.toggle('bg-maxgold', active);
          b.querySelector('span').classList.toggle('bg-transparent', !active);
        });
      });
    });

    // لوحة الأرقام
    const dialInput = document.getElementById('dialInput');
    document.getElementById('dialPad').addEventListener('click', (e) => {
      const b = e.target.closest('[data-digit]');
      if (!b) return;
      dialInput.value += b.dataset.digit;
      MaxCallBridge.sendDTMF({ digit: b.dataset.digit });
    });
    document.getElementById('btnBackspace').addEventListener('click', () => {
      dialInput.value = dialInput.value.slice(0, -1);
    });

    // أزرار الاتصال
    document.getElementById('btnCall').addEventListener('click', () => MaxCallBridge.makeCall({ number: dialInput.value.trim() }));
    document.getElementById('btnHangup').addEventListener('click', () => MaxCallBridge.hangup({}));
    document.getElementById('btnHold').addEventListener('click', () => MaxCallBridge.hold({ on: true }));
    document.getElementById('btnAnswer').addEventListener('click', () => MaxCallBridge.answer({}));
    document.getElementById('btnReject').addEventListener('click', () => MaxCallBridge.hangup({}));
    document.getElementById('presenceSelect').addEventListener('change', (e) => MaxCallBridge.setPresence({ status: e.target.value }));

    // اتصال سريع من الجهات
    document.querySelectorAll('[data-call]').forEach((b) =>
      b.addEventListener('click', () => MaxCallBridge.makeCall({ number: b.dataset.call }))
    );
  </script>
<script>window.addEventListener("DOMContentLoaded",function(){if(window.MaxCallBridge&&window.MaxCallBridge.ready)window.MaxCallBridge.ready();});</script></body>
</html>
