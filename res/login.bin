<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MaxCall — Sign in</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: { colors: { brand: '#087B78', branddark: '#075B59', gold: '#D6A62A' } } } };
  </script>
</head>
<body class="bg-slate-200 text-slate-800 antialiased">
  <div class="mx-auto flex min-h-screen w-full max-w-[320px] flex-col justify-center bg-white p-5 shadow-xl select-none">

    <div class="mb-5 flex items-center gap-2.5">
      <img id="loginLogo" src="data:image/png;base64," alt="MaxCall logo" class="h-16 w-16 shrink-0 rounded-full object-cover ring-2 ring-gold" />
      <div class="min-w-0">
        <p class="text-base font-bold leading-tight">MaxCall</p>
        <p class="text-xs text-slate-500">Sign in</p>
      </div>
    </div>

    <form id="loginForm" class="space-y-3" autocomplete="on">
      <div>
        <label for="loginUser" class="mb-1 block text-xs font-bold text-slate-600">Username</label>
        <input id="loginUser" name="username" dir="ltr" autocomplete="username" autofocus placeholder="e.g. 101"
          class="w-full rounded-xl bg-slate-50 px-3 py-2 text-sm font-semibold outline-none ring-1 ring-slate-200 placeholder:font-normal placeholder:text-slate-400 focus:bg-white focus:ring-2 focus:ring-brand" />
      </div>

      <div>
        <label for="loginPass" class="mb-1 block text-xs font-bold text-slate-600">Password</label>
        <input id="loginPass" name="password" type="password" dir="ltr" autocomplete="current-password" placeholder="••••••••"
          class="w-full rounded-xl bg-slate-50 px-3 py-2 text-sm font-semibold outline-none ring-1 ring-slate-200 placeholder:font-normal placeholder:text-slate-400 focus:bg-white focus:ring-2 focus:ring-brand" />
      </div>

      <p id="loginError" role="alert" aria-live="polite" class="hidden rounded-xl bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-600 ring-1 ring-rose-100"></p>

      <button id="btnSignIn" type="submit"
        class="flex w-full items-center justify-center gap-2 rounded-2xl bg-brand py-2.5 text-sm font-bold text-white shadow-lg shadow-teal-900/20 transition hover:bg-branddark active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60">
        <svg id="loginSpinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="hidden h-4 w-4 animate-spin"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25" stroke-width="4"/><path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
        <span id="loginBtnLabel">Sign in</span>
      </button>
    </form>

  </div>

  <script>
    'use strict';

    // Same rule as web-shell/BRIDGE.md §1 and app.js _postToNative:
    // always send a JSON *string* — C++ reads it with TryGetWebMessageAsString.
    function _postToNative(msg) {
      var text = null;
      try { text = JSON.stringify(msg); }
      catch (err) { console.warn('[MaxCallLogin] stringify failed:', err); return false; }
      try {
        if (window.chrome && window.chrome.webview && typeof window.chrome.webview.postMessage === 'function') {
          window.chrome.webview.postMessage(text);
          return true;
        }
      } catch (err) {
        console.warn('[MaxCallLogin] postMessage failed:', err);
      }
      console.log('[MaxCallLogin:fallback]', text);
      return false;
    }

    function _setBusy(busy) {
      var btn = document.getElementById('btnSignIn');
      var spinner = document.getElementById('loginSpinner');
      var label = document.getElementById('loginBtnLabel');
      if (btn) btn.disabled = !!busy;
      if (spinner) spinner.classList.toggle('hidden', !busy);
      if (label) label.textContent = busy ? 'Signing in…' : 'Sign in';
      ['loginUser', 'loginPass'].forEach(function (id) {
        var f = document.getElementById(id);
        if (f) f.disabled = !!busy;
      });
    }

    // C++ → JS (called via ExecuteScript, see LOGIN_BRIDGE.md §3).
    window.onLoginBusy = function (busy) { _setBusy(!!busy); };

    // C++ → JS (called via ExecuteScript, see LOGIN_BRIDGE.md §3).
    window.onLoginError = function (message) {
      var el = document.getElementById('loginError');
      var text = String(message || '');
      if (!el) return;
      el.textContent = text;
      el.classList.toggle('hidden', !text);
    };

    document.getElementById('loginForm').addEventListener('submit', function (ev) {
      ev.preventDefault();
      window.onLoginError('');
      var user = document.getElementById('loginUser').value.trim();
      var pass = document.getElementById('loginPass').value;
      if (!user || !pass) {
        window.onLoginError('Please enter username and password.');
        return;
      }
      if (/^\d+$/.test(user)) {
        window.onLoginError('Please sign in with your username, not the extension number.');
        return;
      }
      _postToNative({ action: 'login', username: user, password: pass });
    });
  </script>
</body>
</html>
